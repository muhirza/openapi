# ============================================
# MVP0 OPEN API SIDIVA Dashboard - Environment
# ============================================

# --- App ---
APP_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-python-from-cryptography.fernet
# First user seeded when the users table is empty (local dev only)
SEED_USERNAME=admin
SEED_PASSWORD=admin12345

# --- Database ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dashboard:dashboard@db:5432/dashboard

# --- Provider API (Get Token) ---
# Base URL is fixed per provider (XL Gateway)
PROVIDER_BASE_URL=https://gateway.egw.xl.co.id
# Token endpoint path
PROVIDER_TOKEN_ENDPOINT=/token
# HTTP method for token request
PROVIDER_TOKEN_METHOD=POST
# Content type: application/x-www-form-urlencoded OR application/json
PROVIDER_TOKEN_CONTENT_TYPE=application/x-www-form-urlencoded
# Grant type
PROVIDER_TOKEN_GRANT_TYPE=client_credentials
# Token lifetime in seconds (assumed 1 hour = 3600)
PROVIDER_TOKEN_LIFETIME_SECONDS=3600
# Optional: extra fields to send with token request
PROVIDER_TOKEN_EXTRA_FIELDS=

# --- Provider API (Balances) ---
PROVIDER_API_PREFIX=/sidompul/openapi/v1

# Eload balance (same endpoint as Dompul, + Type: eload header)
PROVIDER_BALANCE_ELOAD_ENDPOINT=/get-dompul-balance
PROVIDER_BALANCE_ELOAD_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Type: eload

# Dompul balance
PROVIDER_BALANCE_DOMPUL_ENDPOINT=/get-dompul-balance
PROVIDER_BALANCE_DOMPUL_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID

# --- Provider API (History) ---
PROVIDER_HISTORY_ENDPOINT=/get-transaction-history
PROVIDER_HISTORY_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID
PROVIDER_HISTORY_DEFAULT_DAYS=30
PROVIDER_HISTORY_MAX_DAYS=90

# --- Provider API (Product List) ---
PROVIDER_PRODUCT_ENDPOINT=/get-product-list
PROVIDER_PRODUCT_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID

# --- Provider API (Transaction - MVP2) ---
# Encrypt PIN
PROVIDER_ENCRYPT_PIN_ENDPOINT=/post-encrypt
PROVIDER_ENCRYPT_PIN_HEADERS=Authorization: Bearer {token}, apiId: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# Buy Pulsa (W2P)
PROVIDER_BUY_PULSA_ENDPOINT=/post-w2p
PROVIDER_BUY_PULSA_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# Buy Data Package
PROVIDER_BUY_DATA_PACKAGE_ENDPOINT=/post-package
PROVIDER_BUY_DATA_PACKAGE_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# Cocktail SF
PROVIDER_COCKTAIL_SF_ENDPOINT=/post-xwg-tembak
PROVIDER_COCKTAIL_SF_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# Package Injection
PROVIDER_PACKAGE_INJECTION_ENDPOINT=/post-package
PROVIDER_PACKAGE_INJECTION_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# Transaction History Detail
PROVIDER_HISTORY_DETAIL_ENDPOINT=/get-transaction-historydetail
PROVIDER_HISTORY_DETAIL_HEADERS=Authorization: Bearer {token}, apiid: {api_id}, apikey: {api_key}, language: ID, Content-Type: application/json

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Keep in sync with SESSION_IDLE_MINUTES (drives the client-side idle redirect)
NEXT_PUBLIC_SESSION_IDLE_MINUTES=120

# Comma-separated browser origins allowed by the backend CORS middleware
ALLOWED_ORIGINS=http://localhost:3000

# --- Sessions ---
# Log out after this many minutes without activity
SESSION_IDLE_MINUTES=120
# Hard cap on total session age, regardless of activity
SESSION_ABSOLUTE_HOURS=12
# Set to true when the app is served over HTTPS
SESSION_COOKIE_SECURE=false
